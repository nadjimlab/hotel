# Database (PostgreSQL Connection String)
# Example: postgresql://postgres:password@localhost:5432/lagazelledor
# When not provided in development, the engine automatically uses official PostgreSQL WASM (PGlite) with disk persistence
DATABASE_URL=""

# Application Base & Subdomain URLs
APP_URL="https://hotel-lagazelledor.dz"
BOOKING_URL="https://booking.hotel-lagazelledor.dz"
ADMIN_URL="https://admin.hotel-lagazelledor.dz"

# Server Security & Sessions
SESSION_SECRET="change-this-to-a-secure-random-secret-key-in-production"
JWT_SECRET="change-this-to-a-secure-jwt-secret-in-production"

# Payment Provider Configuration
# Supported options: 'arrival' | 'cib_edahabia_sim' | 'international_card_sim'
PAYMENT_PROVIDER="arrival"

# Email / SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="reservations@hotel-lagazelledor.dz"
SMTP_PASSWORD="smtp-app-password-placeholder"
SMTP_FROM="La Gazelle d'Or <reservations@hotel-lagazelledor.dz>"

# Port (Defaults to 3000)
PORT="3000"
